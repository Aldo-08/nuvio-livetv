[{"s":1795868293,"e":1795872802,"t":"폭군의 셰프 7회","d":"마지막 경합을 위해 '압력솥' 제작을 결심한 지영. 당대 최고의 기술자이자 장영실의 후손으로 알려진 장춘생을 찾아 나서지만 쉽지 않은 여정이 펼쳐지는데.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3542586419_2_20260929T025555207Z_36_imageprocessorclient-tvplus-linear-6b56cc9f55-vlfb7.jpeg"},{"s":1795872802,"e":1795877813,"t":"폭군의 셰프 8회","d":"무사히 경합장에 도착한 지영. 요리를 시작하려는데 중요한 재료인 '고추장'과 '고춧가루'가 없다! 지영은 이 위기를 극복할 수 있을까.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3542727857_0_20260929T025554751Z_124_imageprocessorclient-tvplus-linear-6b56cc9f55-t5gd9.jpeg"},{"s":1795877813,"e":1795882945,"t":"폭군의 셰프 9회","d":"숨막히는 긴장감 속에 치열한 경합을 치르는 지영, 그러나 또 다른 사건에 휘말리며 옥고를 치르게 되는데.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3542595118_1_20260929T025555207Z_131_imageprocessorclient-tvplus-linear-6b56cc9f55-4hrj4.jpeg"},{"s":1795882945,"e":1795887912,"t":"폭군의 셰프 10회","d":"지영과 이헌은 진명대군 사건으로 서로의 마음을 확인하지만, 대왕대비의 진찬을 앞두고, 제산대군은 또 다른 음모를 준비한다.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3542640630_0_20260929T025554751Z_147_imageprocessorclient-tvplus-linear-6b56cc9f55-t5gd9.jpeg"},{"s":1795887912,"e":1795893026,"t":"폭군의 셰프 11회","d":"폐비 사건의 진실을 마주하고 폭주하는 이헌. 지영은 갑신사화의 역사를 반복하지 않을 수 있을까.","i":"https://tvpnlogopus.samsungcloud.tv/platform/image/contents/vc/00/LINEAR/KR_USQT620324A_3542669311_2_20260929T025555207Z_31_imageprocessorclient-tvplus-linear-6b56cc9f55-vlfb7.jpeg"}]