[{"s":1795791600,"e":1795795200,"t":"오 마이 주식","c":["교양/정보"]},{"s":1795795200,"e":1795798800,"t":"전기현의 씨네뮤직","c":["음악"]},{"s":1795798800,"e":1795813200,"t":"방송 시간이 아닙니다(6시부터 방송 예정)","c":["교양/정보"]},{"s":1795813200,"e":1795815600,"t":"AI 주식회사","d":"AI를 매개로 다양한 이야기와 사람, 시대의 변화를 자유롭게 풀어가는 토크 프로그램.","c":["교양/정보"]},{"s":1795815600,"e":1795821000,"t":"선 넘은 패밀리","d":"국경을 넘어 사랑의 결실을 맺은 국제 가족들의 일상을 전하는 예능 프로그램.","c":["연예/오락"]},{"s":1795821000,"e":1795824000,"t":"토크쇼 김미화의 단짝","c":["교양/정보"]},{"s":1795824000,"e":1795827000,"t":"김원효 심진화의 반려탐구생활","d":"반려동물과 함께 살아가는 사람들의 일상과 교감을 통해 올바른 반려문화와 공존의 의미를 전하는 프로그램.","c":["교양/정보"]},{"s":1795827000,"e":1795830600,"t":"주식학교 주말반","c":["교양/정보"]},{"s":1795830600,"e":1795836000,"t":"니돈내산 독박투어","d":"20년지기 찐친들과 함께 떠나는 우정여행! 하지만 식사부터 교통, 숙박까지 발생하는 수 많은 비용들! 여행 중 발생하는 각각의 비용들을 복불복 게임을 통해 단 한 명에게 몰아준다면? 안 걸리면 공짜여행, 걸리면 독박여행!","c":["연예/오락"]},{"s":1795836000,"e":1795843200,"t":"OBS 시네마 <드림 호스>","c":["영화"]},{"s":1795843200,"e":1795844400,"t":"야생의 무기","c":["시사/다큐"]},{"s":1795844400,"e":1795847400,"t":"경기의정 예:썰","c":["교양/정보"]},{"s":1795847400,"e":1795848000,"t":"OBS뉴스 330","c":["뉴스"]},{"s":1795848000,"e":1795850400,"t":"세계테마기행","d":"세계테마기행은 단순한 여행 정보 프로그램에서 벗어나, 자유로운 배낭여행자만이 느낄 수 있는 살아있는 체험기를 전해드리고자 기획된 프로그램. 스페인에서 칠레, 남아공에서 알래스카에 이르기까지 전 세계를 직접 발로 뛰며 제작되는 세계테마기행은 찬란한 문명 유적지와 자연유산은 물론 다양한 방식으로 삶을 영위해 가는 세계인들의 숨은 일상까지 생생히 보여준다.","c":["취미/레저"]},{"s":1795850400,"e":1795854600,"t":"극한 직업","d":"우리 사회에는 상상을 초월하는 극도로 힘든 작업환경 속에서 일하는 사람들이 있다. 이런 극한의 직업에 종사하는 사람들의 삶을 밀착 촬영하여 생생하게 보여줌으로써 역경을 극복하고 살아가고자 하는 사람들의 숭고한 의지와 잃어가고 있는 직업정신의 가치를 되돌아본다.","c":["교양/정보"]},{"s":1795854600,"e":1795855200,"t":"OBS뉴스경인 530","c":["뉴스"]},{"s":1795855200,"e":1795858200,"t":"신계숙의 맛터사이클 다이어리","c":["교양/정보"]},{"s":1795858200,"e":1795861800,"t":"하나부터 열까지","c":["연예/오락"]},{"s":1795861800,"e":1795863300,"t":"OBS뉴스 730","c":["뉴스"]},{"s":1795863300,"e":1795866900,"t":"이준영의 WE (World Economy)","c":["교양/정보"]},{"s":1795866900,"e":1795870500,"t":"전기현의 씨네뮤직","c":["음악"]},{"s":1795870500,"e":1795872900