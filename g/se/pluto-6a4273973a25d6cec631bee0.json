eriorating.","c":["Classic Sci-Fi & Fantasy","Series","Science fiction"],"i":"https://images.pluto.tv/series/6278c3825bbb230014ba4abd/tile_1767914643498.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E04"}]