[{"s":1795864962,"e":1795868512,"t":"Raumschiff Enterprise","st":"Kampf um Organia","d":"Während der Krieg tobt, kämpfen Kirk und Spock gegen Klingonen, um Organia zu befreien.","c":["Fantasy","Series","Science fiction"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E27"},{"s":1795868512,"e":1795872063,"t":"Raumschiff Enterprise","st":"Auf Messers Schneide","d":"Kirk und Spock treffen auf einen geheimnisvollen Außerirdischen namens Lazarus, der behauptet, eine rücksichtslose, wahnsinnige Kreatur zu jagen.","c":["Fantasy","Series","Science fiction"],"i":"https://images.pluto.tv/series/696e2da0dee1ecbcdd39dc99/tile_1776902041534.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E28"},{"s":1795872063,"e":1795875273,"t":"Star Trek: The Next Generation","st":"Das Herz eines Captains","d":"Picard kämpft während einer OP um sein Leben, und Geordi wird von den Anführern einer außerirdischen Rasse in Geiselhaft gehalten.","c":["Fantasy","Series","Science fiction"],"i":"https://images.pluto.tv/series/697a0850cd24a9501e1b3b61/tile_1785359161578.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E17"},{"s":1795875273,"e":1795878482,"t":"Star Trek: The Next Generation","st":"Der Planet der Klone","d":"Die Besatzung rettet eine verschwundene Erdenkolonie und entdeckt dabei eine Zivilisation, die vollständig aus Klonen besteht.","c":["Fantasy","Series","Science fiction"],"i":"https://images.pluto.tv/series/697a0850cd24a9501e1b3b61/tile_1785359161578.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E18"},{"s":1795878482,"e":1795881688,"t":"Star Trek: The Next Generation","st":"Andere Sterne, andere Sitten","d":"Trois Mutter sucht den perfekten Partner, beamt sich an Bord der Enterprise und visiert Captain Picard an.","c":["Fantasy","Series","Science fiction"],"i":"https://images.pluto.tv/series/697a0850cd24a9501e1b3b61/tile_1785359161578.jpg?fill=blur&fit=fill&fm=jpg&h=90