[{"s":1795865400,"e":1795868340,"t":"Andromeda: Inn i labyrinten","st":"Inn i labyrinten","d":"En avgrunnsagent prøver å lokke Harper til å bli med i Magog","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E09"},{"s":1795868340,"e":1795871280,"t":"Andromeda: Prinsen","st":"Prinsen","d":"Når de redder en ung prins fra et opprør som dreper resten av familien hans, blir Dylan og Tyr bedt om å være hans rådgivere.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E10"},{"s":1795871280,"e":1795874220,"t":"Andromeda: Bunker Hill","st":"Bunker Hill","d":"Dylan og hans nye Commonwealth-flåte tar på seg Drago-Kazov-flåten, men synes den er mye større enn forventet.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E11"},{"s":1795874220,"e":1795877160,"t":"Andromeda: Ouroboros","st":"Ouroboros","d":"Magog-eggene i Harper begynner å klekkes, så teamet bygger en Tesseract-maskin","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E12"},{"s":1795877160,"e":1795880100,"t":"Andromeda: Lava og raketter","st":"Lava og raketter","d":"Dylan overtar en turistpram i et forsøk på å unnslippe leiesoldater.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E13"},{"s":1795880100,"e":1795883040,"t":"Andromeda: Vær alle mine synder husket","st":"Vær alle mine synder husket","d":"En kroppsidentifikasjon går galt når det viser seg at Bekas tidligere mannskap ikke er død.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E14"},{"s":1795883040,"e":1795885980,"t":"Andromeda: Mayflies dans","st":"Mayflies dans","d":"Andromeda redder døende mennesker fra en drift, men de blir snart til zombier som blir kontrollert av en bikube.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E15"},{"s":1795885980,"e":1795888920,"t":"Andromeda: I himmelen er nå tre","st":"I himmelen er nå tre","d":"Motoren til skapelsen er i stand til å omskrive universet i henhold til eierens ønsker. Dylan, Beka og Trance må skaffe det før noen med mørke planer får det.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E16"},{"s":1795888920,"e":1795891860,"t":"Andromeda: Ting vi ikke kan endre","st":"Ting vi ikke kan endre","d":"Et svart hull slår Dylan ut og sender ham inn i en alternativ virkelighet med kone og barn.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E17"},{"s":1795891860,"e":1795894800,"t":"Andromeda: The Fair Unknown","st":"The Fair Unknown","d":"Mannskapet redder en av de tapt grunnleggerne av Commonwealth, men oppdager at hun kan være mer trøbbel enn hun er verdt.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E18"},{"s":1795894800,"e":1795897740,"t":"Andromeda: Dyrets mage","st":"Dyrets mage","d":"Et mytologisk rommonster prøver å spise Andromeda.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E19"},{"s":1795897740,"e":1795900680,"t":"Andromeda: Ridderen, døden og djevelen","st":"Ridderen, døden og djevelen","d":"Dylan prøver å frigjøre en flåte med fangede skip, men flåten er ikke sikker på at den vil bli frigjort. AI-ene deres frykter at nye kapteiner vil slavebinde dem.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E20"},{"s":1795900680,"e":1795903620,"t":"Andromeda: Immaculate Perception","st":"Immaculate Perception","d":"Genitter angriper Tyrs kone og koloni.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E21"},{"s":1795903620,"e":1795906560,"t":"Andromeda: Tunnel ved enden av lyset","st":"Tunnel ved enden av lyset","d":"Med femti partier ombord er Dylan vert for signeringen av New Commonwealth-charteret, men oppdager snart at det er inntrengere som har til hensikt å stoppe signeringen.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E22"},{"s":1795906560,"e":1795909500,"t":"Andromeda: Hvis hjulet er løst","st":"Hvis hjulet er løst","d":"Beka og Tyr blir overtatt av energien fra en dimensjonal tunnel. Dylan, Trance og Harper må redde dem før de ødelegger skipet.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E01"},{"s":1795909500,"e":1795912440,"t":"Andromeda: Skårene i Rimni","st":"Skårene i Rimni","d":"Dylan er innrammet for drap og må rydde navnet sitt mens han finner bitene i en vase som sies å gi eieren kosmos 'velsignelser.'","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E02"},{"s":1795912440,"e":1795915380,"t":"Andromeda: Mad to Be Saved","st":"Mad to Be Saved","d":"Mannskapet redder en gruppe flyktninger, bare for å oppdage at de har vært utsatt for regjeringseksperimenter og er ekstremt ustabile.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E03"},{"s":1795915380,"e":1795918320,"t":"Andromeda: Cui Bono","st":"Cui Bono","d":"Bekas onkel løper for kontoret i New Commonwealth, men et attentat får mannskapet til å opptre som hans sikkerhet.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E04"},{"s":1795918320,"e":1795921260,"t":"Andromeda: Den ensomme og jevne sanden","st":"Den ensomme og jevne sanden","d":"Når Andromeda blir angrepet av rompirater, blir de reddet av et langt mistet romskip fra jorden.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E05"},{"s":1795921260,"e":1795924200,"t":"Andromeda: Slipfighter Hunder av Krig","st":"Slipfighter Hunder av Krig","d":"Mannskapet oppdager at en falsk planet, Marduk, har skapt masseødeleggelsesvåpen.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E06"},{"s":1795924200,"e":1795927140,"t":"Andromeda: Lepras kyss","st":"Lepras kyss","d":"En hitman med navnet Leper er rettet mot lederne for det nye samveldet.","c":["Series","Adventure","Science fiction"],"i":"https://images.pluto.tv/series/61bc8a040a7fe8001a080734/tile_1776072601229.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E07"}]