[{"s":1795864581,"e":1795867821,"t":"Doc Martin: Episode 607","st":"Episode 607","d":"Al får besøk av to militære politimenn som prøver å spore opp barnevakten James, Mike Pruddy.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E07"},{"s":1795867821,"e":1795871001,"t":"Doc Martin: Episode 608","st":"Episode 608","d":"Louisa drar til Spania, Bert og Jennifer forlovelsesfest ender med et smell, og Al blir hyllet som en helt for å ha reddet Carolines liv.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S06E08"},{"s":1795871001,"e":1795874401,"t":"Doc Martin: Episode 101","st":"Episode 101","d":"Dr. Martin bestemmer seg for å forlate London og flytte til en pittoresk fiskerlandsby. Der møter han snart en av landsbyens karakterer og sønnen hans, som tar seg friheten å fikse doktor Martins hus.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E01"},{"s":1795874401,"e":1795877778,"t":"Doc Martin: Episode 102","st":"Episode 102","d":"Martins første arbeidsdag kan også bli hans siste.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E02"},{"s":1795877778,"e":1795881161,"t":"Doc Martin: Episode 103","st":"Episode 103","d":"En diaréepidemi rammer byen og Martin tar umiddelbart grep.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E03"},{"s":1795881161,"e":1795884555,"t":"Doc Martin: Episode 104","st":"Episode 104","d":"Martin drar på hjemmebesøk til en skogvokter som deler sitt hjem med et gigantisk ekorn.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E04"},{"s":1795884555,"e":1795887943,"t":"Doc Martin: Episode 105","st":"Episode 105","d":"En gammel venn av Joan dukker opp og vekker gamle minner.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E05"},{"s":1795887943,"e":1795891341,"t":"Doc Martin: Episode 106","st":"Episode 106","d":"Ryktene om legens \"lille\" problem med blod sirkulerer i landsbyen. Peter Cronk er skadet og bekymringen for hans helse bringer Martin og Louisa nærmere hverandre.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S01E06"},{"s":1795891341,"e":1795894672,"t":"Doc Martin: Episode 201","st":"Episode 201","d":"Louisas gamle flamme, Danny Steel, kommer til Portwenn i håp om å gjenopplive romansen deres.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E01"},{"s":1795894672,"e":1795898045,"t":"Doc Martin: Episode 202","st":"Episode 202","d":"Når moren hans må på sykehus, trenger Peter Cronk et sted å bo.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E02"},{"s":1795898045,"e":1795901430,"t":"Doc Martin: Episode 203","st":"Episode 203","d":"Al oppdager at Bert ikke er hans biologiske far.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E03"},{"s":1795901430,"e":1795904806,"t":"Doc Martin: Episode 204","st":"Episode 204","d":"En gammel mann som har en uforklarlig stank, konsulterer doktor Ellingham; og den lokale radioverten, Caroline, har et alvorlig drikkeproblem.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E04"},{"s":1795904806,"e":1795908189,"t":"Doc Martin: Episode 205","st":"Episode 205","d":"Martin undersøker Helen Pratt, men hun kollapser og dør. Mannen hennes, Phil, er sint på legen og gir ham skylden for konas død.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E05"},{"s":1795908189,"e":1795911558,"t":"Doc Martin: Episode 206","st":"Episode 206","d":"Martins vanskelige foreldre kommer for å bo hos ham. Han har ikke sett dem på syv år, og er forvirret over hvorfor de plutselig skulle dukke opp nå.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E06"},{"s":1795911558,"e":1795914946,"t":"Doc Martin: Episode 207","st":"Episode 207","d":"Mark Mylow planlegger å tilbringe sitt utdrikningslag i skogen med Al Large, men han blir bitt av en huggorm.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E07"},{"s":1795914946,"e":1795918466,"t":"Doc Martin: Episode 208","st":"Episode 208","d":"Et medlem av Frelsesarmeen kommer til Portwenn for å prøve å finne en savnet kvinne. Danny ber sin motvillige kjæreste Louisa om flytte inn hos ham.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S02E08"},{"s":1795918466,"e":1795921826,"t":"Doc Martin: Episode 301","st":"Episode 301","d":"Martin mistenker at Louisa kan ha anemi. Tante Joan blir tvunget til å motta behandling fra Martin etter at hun nesten kjørte på noen.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E01"},{"s":1795921826,"e":1795925155,"t":"Doc Martin: Episode 302","st":"Episode 302","d":"Bert Large forlater rørleggerfirmaet sitt til fordel for å drive en restaurant. Etter restaurantens åpning forekommer det flere tilfeller av matforgiftning.","c":["Inspirational Drama","Series","Drama"],"i":"https://images.pluto.tv/series/62454f3b25269a0013abb27a/tile_1788441495996.jpg?fill=blur&fit=fill&fm=jpg&h=900&q=75&w=900","ep":"S03E02"}]